# Cyber Companion Wisp v0.9 native system-media preview
# Seven 24-frame clips are compiled from a three-layer hierarchical source rig.
# Media uses StartWorking/Working/EndWorking; CPU and sleep remain disabled.
# No keyboard_device is intentionally configured.

cat_height=224
cat_align=right

# With right alignment, positive values move the sprite left/inward.
cat_x_offset=112
cat_y_offset=-12

overlay_height=256
overlay_position=bottom
overlay_layer=overlay
overlay_opacity=0

enable_antialiasing=1
enable_debug=0
# Target a 75 Hz compositor refresh rate for smoother translation.
fps=75

custom_sprite_sheet_filename=assets/sprites/companion-wisp-system-v0.9.png
animation_name=custom
custom_idle_frames=24
custom_start_working_frames=24
custom_working_frames=24
custom_end_working_frames=24
custom_start_moving_frames=24
custom_moving_frames=24
custom_end_moving_frames=24
custom_mirror_x_moving=1

# 24 interpolated poses at approximately 24 FPS: ~1 s per complete clip.
idle_animation=1
animation_speed=42
idle_sleep_timeout=0
happy_kpm=0
cpu_threshold=0

# The behavior director is the only movement authority. Autonomous travel is
# disabled so the renderer cannot rotate or move Wisp independently.
movement_radius=0
movement_speed=0
movement_wait_factor=0
enable_movement_debug=0

# Monitor selection is supplied by scripts/run-renderer.sh.
