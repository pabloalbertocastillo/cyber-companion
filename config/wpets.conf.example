# Cyber Companion v0.3 prototype
# Autonomous system avatar for Wayland V-Pets. This configuration exists only
# to reproduce the rejected v0.3 visual prototype while Wisp v1 is produced
# against docs/SPRITE_SPEC.md.
# No keyboard_device is intentionally configured.

cat_height=112
cat_align=right

# With right alignment, positive values move the sprite left/inward.
cat_x_offset=56
cat_y_offset=-6

overlay_height=136
overlay_position=bottom
overlay_layer=overlay
overlay_opacity=0

enable_antialiasing=1
enable_debug=0
fps=30

animation_name=custom
custom_sprite_sheet_filename=/data/Development/projects/cyber-companion/assets/sprites/companion-wisp-v0.3.png

# Experimental rows 1-9: idle, boring, writing, happy, asleep, sleep,
# wake up, working and moving. These independent poses do not meet the Wisp v1
# transition and fixed-pivot contract.
custom_idle_frames=2
custom_boring_frames=2
custom_writing_frames=2
custom_happy_frames=2
custom_asleep_frames=2
custom_sleep_frames=2
custom_wake_up_frames=2
custom_working_frames=2
custom_moving_frames=2
custom_mirror_x_moving=1

# Keep the resting pose stable; animate state transitions and movement.
idle_animation=0

# One-pixel steps every 50 ms target 20 position updates per second.
animation_speed=50
idle_sleep_timeout=300

# System activity: use the working animation above 70% CPU.
update_rate=1000
cpu_threshold=70
cpu_running_factor=0.35

# Autonomous movement near the lower-right corner.
movement_radius=260
movement_speed=1
movement_wait_factor=30.0
enable_movement_debug=0

# The workstation uses DP-2 on the left and DP-1 on the right.
monitor=DP-2
