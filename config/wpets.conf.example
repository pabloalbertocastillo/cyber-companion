# Cyber Companion Wisp v0.4 idle preview
# This deliberately enables only the six-frame idle loop. CPU reactions and
# autonomous movement remain disabled until their transition rows are ready.
# No keyboard_device is intentionally configured.

cat_height=112
cat_align=right

# With right alignment, positive values move the sprite left/inward.
cat_x_offset=56
cat_y_offset=-6

overlay_height=136
overlay_position=bottom
overlay_layer=overlay
overlay_opacity=0

enable_antialiasing=1
enable_debug=0
fps=60

animation_name=custom
custom_sprite_sheet_filename=/data/Development/projects/cyber-companion/assets/sprites/companion-wisp-idle-v0.4.png
custom_idle_frames=6

# Six deterministic frames, 160 ms each: a restrained 960 ms hover loop.
idle_animation=1
animation_speed=160
idle_sleep_timeout=0

# Freeze world-space position for this visual acceptance pass.
movement_radius=0
movement_speed=0
enable_movement_debug=0

# The workstation uses DP-2 on the left and DP-1 on the right.
monitor=DP-2
